# ============================================================
# SUPABASE
# Korean Learning Platform — tsuha.id
# ============================================================

# Project URL (public, safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon/Publishable key (public, safe for client — enforces RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXX

# ⚠️ SECRET — Server only! Set via Vercel Environment Variables.
# NEVER prefix with NEXT_PUBLIC_ — NEVER commit actual values.
# SUPABASE_SECRET_KEY=<set in Vercel Dashboard>
# SUPABASE_SERVICE_ROLE_KEY=<set in Vercel Dashboard>

# Project Reference ID
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# ============================================================
# MIDTRANS
# ============================================================

# Client Key (public, safe for client — used by Snap.js)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-XXXX

# ⚠️ SECRET — Server only! Set via Vercel Environment Variables.
# NEVER prefix with NEXT_PUBLIC_ — NEVER commit actual values.
# MIDTRANS_SERVER_KEY=<set in Vercel Dashboard>

NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Sandbox (development)
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
# Production (uncomment when going live)
# NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js

# ============================================================
# RESEND (email service)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================================
# ALIBABA CLOUD AI (Korean Buddy)
# ⚠️ SECRET — Server only! Set via Vercel Environment Variables.
# ============================================================
# ALIBABA_API_KEY=<set in Vercel Dashboard>

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Korean Learning Platform

# ⚠️ SECRET — Server only! Set via Vercel Environment Variables.
# CRON_SECRET=<set in Vercel Dashboard>
